{
  // Static SPA: Cloudflare Workers serves dist/, and any unknown path falls back
  // to index.html so react-router deep links work.
  "name": "pet-admin",
  "compatibility_date": "2026-10-18",
  "vars": {
    "VITE_API_BASE_URL": "https://api.petpallets.com/api/v1"
  },  
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  // Custom domain (needs the zone on the same Cloudflare account):
  // "routes": [{ "pattern": "admin.petpallets.com", "custom_domain": true }]
}
